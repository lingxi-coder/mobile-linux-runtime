 /* Auto-create a meta.db entry for a path under a bind mount.
  * Probes the host filesystem to determine if it's a file or directory. */
+/* Mobile host-backed files belong to the guest account, never the host UID.
+ * Root's administrative home retains root ownership. */
+static unsigned lx_guest_path_owner(const char *path) {
+    if (path[0] == '/') path++;
+    return (!strcmp(path, "home/lingxi") || !strncmp(path, "home/lingxi/", 12)
+        || !strncmp(path, "var/lingxi/", 11)) ? 1000 : 0;
+}
+
