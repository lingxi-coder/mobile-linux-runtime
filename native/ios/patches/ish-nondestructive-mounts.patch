+/* Child mounts are table-only overlays. A physical link below an already
+ * bound HOME would delete the real host directory and replace it with a
+ * self-link. The longest-prefix translator handles these overlays instead. */
+static bool lx_mount_has_parent(const char *path) {
+    for (int i = 0; i < FAKEFS_MAX_BIND_MOUNTS; i++) {
+        const struct fakefs_bind_mount *parent = &g_bind_mounts[i];
+        if (parent->active && strlen(path) > (size_t)parent->path_len &&
+            !strncmp(path, parent->path, parent->path_len) && path[parent->path_len] == '/')
+            return true;
+    }
+    return false;
+}
+
+static int lx_mount_install_link(struct fakefs_bind_mount *mount,
+                                 const char *linux_path, const char *host_path,
+                                 bool replacing) {
+    if (!mount->materialized) return 0;
+    char leaf[PATH_MAX];
+    int parent = lx_mount_parent_fd(g_fakefs_mount->root_fd, fix_path(linux_path), leaf);
+    if (parent < 0) return _EBUSY;
+    if (replacing) {
+        struct stat state;
+        if (fstatat(parent, leaf, &state, AT_SYMLINK_NOFOLLOW) == 0) {
+            if (!lx_mount_link_matches(parent, leaf, mount->owned_link_target) ||
+                unlinkat(parent, leaf, 0) < 0) {
+                close(parent);
+                return _EBUSY;
+            }
+        } else if (errno != ENOENT) {
+            close(parent);
+            return _EBUSY;
+        }
+    } else {
+        /* Every parent was opened with O_NOFOLLOW. No HOME, overlay or guest
+         * symlink can redirect this cleanup into persistent host storage. */
+        remove_tree_at(parent, leaf);
+    }
+    int result = create_relative_symlink(parent, leaf, host_path);
+    if (result == 0) {
+        ssize_t count = readlinkat(parent, leaf, mount->owned_link_target,
+                                  sizeof(mount->owned_link_target) - 1);
+        if (count < 0 || (size_t)count >= sizeof(mount->owned_link_target) - 1)
+            result = -1;
+        else
+            mount->owned_link_target[count] = '\0';
+    }
+    close(parent);
+    return result < 0 ? _EINVAL : 0;
+}
