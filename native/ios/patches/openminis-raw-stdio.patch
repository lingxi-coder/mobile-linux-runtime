+                descriptor = ctx.stdinWriteFd;
+                n = write(descriptor, bytes, remaining);
+            }
+            if (n > 0) { bytes += n; remaining -= (NSUInteger)n; continue; }
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)
+                    && [NSDate timeIntervalSinceReferenceDate] < deadline) {
+                struct pollfd pending = { .fd = descriptor, .events = POLLOUT };
+                poll(&pending, 1, 25);
