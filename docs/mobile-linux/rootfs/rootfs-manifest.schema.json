{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crates/mobile-linux/rootfs-manifest.schema.json",
  "title": "LingXi Mobile Linux Rootfs Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "platform",
    "abi",
    "rootfs_version",
    "content_sha256",
    "sbom_filename",
    "source_pins_filename",
    "archive",
    "packages",
    "executable_allowlist",
    "immutable_files",
    "writable_paths"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "android-proot"
          }
        }
      },
      "then": {
        "properties": {
          "platform": {
            "const": "android"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "ios-ish"
          }
        }
      },
      "then": {
        "properties": {
          "platform": {
            "const": "ios"
          },
          "abi": {
            "const": "arm64"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "runtime": {
      "type": "string",
      "enum": [
        "android-proot",
        "ios-ish"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios"
      ]
    },
    "abi": {
      "type": "string",
      "enum": [
        "arm64",
        "x86_64"
      ]
    },
    "rootfs_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9._-]+)?$"
    },
    "brand_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_id", "linux_user", "config_dir_name"],
      "properties": {
        "brand_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$" },
        "linux_user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$", "not": { "const": "root" } },
        "config_dir_name": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9._-]{0,62}$" }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sbom_filename": {
      "const": "rootfs.spdx.json"
    },
    "source_pins_filename": {
      "const": "mobile-linux-pins.json"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "license",
          "architecture",
          "origin"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "executable_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/[^.].*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "elf",
              "shared-library",
              "interpreter"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "immutable_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "kind",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/[^.].*"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "regular-file",
              "symlink"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\/root|\\/tmp|\\/var\\/tmp|\\/home\\/[^/]+(\\/[^/]+)?)$"
      },
      "allOf": [
        {
          "contains": {
            "pattern": "^\\/home\\/[^/]+$"
          }
        },
        {
          "contains": {
            "const": "/root"
          }
        },
        {
          "contains": {
            "const": "/tmp"
          }
        },
        {
          "contains": {
            "const": "/var/tmp"
          }
        },
        {
          "contains": {
            "pattern": "^\\/home\\/[^/]+\\/[^/]+$"
          }
        }
      ]
    }
  }
}
